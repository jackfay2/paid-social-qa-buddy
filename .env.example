QA_LOG_LEVEL=INFO
QA_SERVICE_ROLE=worker
QA_BOT_INITIAL=QA-BOT

# Slack (worker posts to threads via shared @qa-buddy bot)
SLACK_BOT_TOKEN=

# GCP
GCP_PROJECT_ID=prj-prd-ai-ppc-qa-pkph
QA_USE_SECRET_MANAGER=false

# BigQuery (Meta data via Airbyte sync)
BQ_META_PROJECT=polaris-data-317717

# Polaris (client directory lookup; auth uses `Token <token>` header, NOT Bearer)
POLARIS_API_URL=https://api.polaris.wpromote.com
POLARIS_API_TOKEN=

# Cloud Tasks worker auth (set when deployed)
QA_CLOUD_TASKS_AUTH_REQUIRED=true
QA_CLOUD_TASKS_OIDC_AUDIENCE=
QA_CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=ppc-qa-buddy@prj-prd-ai-ppc-qa-pkph.iam.gserviceaccount.com

# Firestore run tracking
QA_RUN_STORE_BACKEND=firestore
QA_FIRESTORE_COLLECTION_NAME=qa_runs

# Gemini (batched text checks)
GEMINI_API_KEY=
QA_GEMINI_MODEL=gemini-2.0-flash
QA_GEMINI_CONFIDENCE_THRESHOLD=0.8
QA_GEMINI_TIMEOUT_SECONDS=15

# Worker runtime guard (12-factor IX: graceful disposal)
QA_WORKER_MAX_RUNTIME_SECONDS=900
